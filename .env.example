# Desenvolvimento local. Copie para .env (ignorado pelo Git).
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# RENDER_EXTERNAL_URL é fornecida pelo Render; configure PUBLIC_ORIGIN para domínio próprio.

# Local direto. No Render, informe saltos E IPs/CIDRs confirmados do ingress.
TRUST_PROXY=0
TRUSTED_PROXY_CIDRS=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/avant_store
DB_POOL_SIZE=10
# Ative true para TLS verificado quando necessário; ausente usa configuração da URL/driver.
PG_SSL=
REDIS_URL=redis://localhost:6379
ALLOW_PRODUCTION_SEED=false
PREVIEW_PORT=3000

SHIPPING_ORIGIN_CEP=
SHIPPING_MARGIN_CENTS=400
# Só ative após medir cada unidade embalada e confirmar despacho separado por unidade.
SHIPPING_PACKAGES_CONFIRMED=false
CORREIOS_SERVICES=PAC,SEDEX
CORREIOS_PAC_CODE=03298
CORREIOS_SEDEX_CODE=03220
CORREIOS_API_VERSION=v1
CORREIOS_TIMEOUT_MS=12000

# Modo automático: configure as três credenciais de API CWS no servidor.
CORREIOS_USER=
CORREIOS_ACCESS_CODE=
CORREIOS_POSTING_CARD=
# Par opcional (ambos necessários quando informado).
CORREIOS_CONTRACT=
CORREIOS_DR=
# Alternativa estática: deixe as três credenciais automáticas vazias e renove manualmente.
CORREIOS_BEARER_TOKEN=
